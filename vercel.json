{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/titulky/",
      "destination": "/efektive-captions/app/public/index"
    },
    {
      "source": "/titulky/:path*",
      "destination": "/efektive-captions/app/public/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "patreon.efektive.cz"
        }
      ],
      "destination": "/patreon"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "patreon.teeceeportfolio.com"
        }
      ],
      "destination": "/patreon"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portfolio.efektive.cz"
        }
      ],
      "destination": "/portfolio"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "klienti.efektive.cz"
        }
      ],
      "destination": "/klienti"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/titulky",
      "destination": "/titulky/",
      "permanent": false
    }
  ],
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 60
    }
  }
}
